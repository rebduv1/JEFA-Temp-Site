 "intro": {
  "heading": "Where the states stand.",
  "body": "For a family to receive an EFTC scholarship, their state must opt in to the program. Governors are deciding now \u2014 here is where each one stands.",
  "labels": {
   "in": "opted in",
   "announced": "announced",
   "vetoed": "governor vetoed",
   "declined": "declined",
   "undecided": "no decision yet"
  }
 },
 "groups": {
  "in": {
   "title": "States that have opted in",
   "blurb": "These states are participating. Their governors submit qualifying Scholarship Granting Organizations to the U.S. Treasury each year, and scholarships become available to families once the program begins January 1, 2027."
  },
  "announced": {
   "title": "States that have announced they will opt in",
   "blurb": "These governors have said publicly that they intend to participate but have not yet completed the formal opt-in. Watch for them to finalize before the program begins."
  },
  "undecided": {
   "title": "States that have not yet decided",
   "blurb": "These governors have not announced a decision either way. Time is short \u2014 the program goes live January 1, 2027."
  },
  "vetoed": {
   "title": "States where the governor vetoed an opt-in bill",
   "blurb": "In these states the legislature passed an opt-in bill and the governor vetoed it. Absent an override or a reversal, families here will not be eligible for scholarships."
  },
  "declined": {
   "title": "States that have declined to participate",
   "blurb": "These governors have stated their states will not take part. Families here will not be eligible for scholarships unless the decision is reversed."
  }
 },
